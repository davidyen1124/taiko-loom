{
  "name": "taiko-nights",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "uv run --project backend uvicorn taiko_backend.main:app --host 127.0.0.1 --port 8000",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test": "node --test tests/engine.test.mjs tests/analyze.test.mjs",
    "test:backend": "uv run --project backend pytest -q backend/tests",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "analyze": "uv run --project backend python scripts/analyze_track.py"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "lucide-react": "^1.47.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2"
  },
  "description": "A festival taiko rhythm game. Upload any song and play it on Easy, Medium or Hard."
}
